---
import Demo from '../components/Demo.astro'
import GitHubMark from '../components/GitHubMark.astro'
import ChromeMark from '../components/ChromeMark.astro'
import Logo from '../components/Logo.astro'
import { formatDate, formatSize, getReleases, inline } from '../data/releases'
import '../styles/global.css'
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right'
import AtSign from '@lucide/astro/icons/at-sign'
import Braces from '@lucide/astro/icons/braces'
import ChevronDown from '@lucide/astro/icons/chevron-down'
import Download from '@lucide/astro/icons/download'
import FolderOpen from '@lucide/astro/icons/folder-open'
import Globe from '@lucide/astro/icons/globe'
import Layers2 from '@lucide/astro/icons/layers-2'
import Library from '@lucide/astro/icons/library'
import ListMusic from '@lucide/astro/icons/list-music'
import MessageSquarePlus from '@lucide/astro/icons/message-square-plus'
import MousePointer2 from '@lucide/astro/icons/mouse-pointer-2'
import Play from '@lucide/astro/icons/play'
import RefreshCw from '@lucide/astro/icons/refresh-cw'
import ShieldCheck from '@lucide/astro/icons/shield-check'
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal'
import SunMoon from '@lucide/astro/icons/sun-moon'
import Tag from '@lucide/astro/icons/tag'
import ToggleRight from '@lucide/astro/icons/toggle-right'
import Waypoints from '@lucide/astro/icons/waypoints'

const REPO = 'https://github.com/kasvith/setflow'
const STORE = 'https://chromewebstore.google.com/detail/setflow/fmfegpgkfagkbdaphhncebipgphjdejc'
const releases = await getReleases()
const [latest, ...older] = releases

const features = [
  {
    icon: Layers2,
    tone: 'text-p2',
    title: 'Phases with colour',
    text: 'Name each stretch of the night, give it a length and a colour. Every track picks up the colour of the phase it plays in, split in two when it straddles a boundary.',
  },
  {
    icon: MousePointer2,
    tone: 'text-p4',
    title: 'Hover to time-travel',
    text: 'Move across a track and read the clock at that exact second, the phase it lands in, and how far into the track you are.',
  },
  {
    icon: SunMoon,
    tone: 'text-p1',
    title: 'Sunrise and sunset',
    text: 'Type the times and the playlist shows which track carries the sun up or down, with a countdown as you hover and a marker on the strip.',
  },
  {
    icon: Waypoints,
    tone: 'text-p3',
    title: 'A plan above the tracklist',
    text: 'Name, span, how much of the plan the music covers, and a strip you can scrub to find the track playing at any minute.',
  },
  {
    icon: Library,
    tone: 'text-[#26c6da]',
    title: 'Library and presets',
    text: 'Journeys are saved per playlist and reopen when you come back. Presets run from a quick two hours to a full twelve.',
  },
  {
    icon: Braces,
    tone: 'text-[#66bb6a]',
    title: 'Export the set',
    text: 'Every track with its clock time, phase and link as JSON, ready for a rider, a cue sheet, or your own tooling.',
  },
]

const steps = [
  { icon: ListMusic, title: 'Open a playlist', text: 'Any playlist on YouTube Music. Setflow reads the track lengths straight from the page.' },
  { icon: SlidersHorizontal, title: 'Shape the plan', text: 'Click the icon, set a start time, edit the phases or pick a preset, add sunrise and sunset if the night needs them.' },
  { icon: Play, title: 'Start planning', text: 'The playlist is marked up in place. Hover to explore, scrub the strip, export the list when you are done.' },
]

const h2 = 'max-w-[640px] text-[clamp(1.8rem,4vw,2.6rem)] font-bold leading-[1.1] tracking-tight'
const notesClass = 'grid gap-x-7 gap-y-5 [grid-template-columns:repeat(auto-fit,minmax(240px,1fr))]'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Setflow · plan your set on YouTube Music</title>
    <meta name="description" content="Setflow is a Chrome extension that lays a plan over any YouTube Music playlist: phases with colours and durations, sunrise and sunset markers, and the clock time every track will play." />
    <meta property="og:title" content="Setflow" />
    <meta property="og:description" content="A timeline for your YouTube Music playlist. Phases, sunrise and sunset, and the clock time of every track." />
    <meta property="og:image" content="https://setflow.kasvith.me/og.png" />
    <meta property="og:url" content="https://setflow.kasvith.me/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#121320" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/AtkinsonHyperlegibleNext.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-ground text-ink">
    <header class="sticky top-0 z-20 border-b border-line bg-ground/70 backdrop-blur-xl">
      <div class="wrap flex h-16 items-center justify-between">
        <a href="#top" class="flex items-center gap-2.5 text-[17px] font-bold tracking-tight" aria-label="Setflow home">
          <Logo />
          Setflow
        </a>
        <nav class="flex items-center gap-6 text-sm">
          <a class="text-muted transition-colors hover:text-ink max-sm:hidden" href="#features">Features</a>
          <a class="text-muted transition-colors hover:text-ink max-sm:hidden" href="#how">How it works</a>
          <a class="text-muted transition-colors hover:text-ink max-sm:hidden" href="#releases">Releases</a>
          <a class="text-muted transition-colors hover:text-ink max-sm:hidden" href="#about">About</a>
          <a class="text-muted transition-colors hover:text-ink max-sm:hidden" href={REPO} rel="noopener">GitHub</a>
          <a class="inline-flex items-center gap-2 rounded-lg bg-ink px-3 py-1.5 font-semibold text-ground transition-colors hover:bg-white" href={STORE} rel="noopener">
            <ChromeMark size={15} /> Add to Chrome
          </a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="relative overflow-clip pt-20 pb-10">
        <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
          <span class="absolute -top-44 left-[8%] size-[560px] animate-drift rounded-full bg-p2 blur-[90px] [--o:0.5]"></span>
          <span class="absolute top-10 right-[4%] size-[560px] animate-drift rounded-full bg-p3 blur-[90px] [--o:0.5] [animation-delay:-7s]"></span>
          <span class="absolute top-[380px] left-[42%] size-[380px] animate-drift rounded-full bg-p1 blur-[90px] [--o:0.18] [animation-delay:-12s]"></span>
        </div>

        <div class="wrap max-w-[780px] text-center">
          <h1 class="rise animate-shimmer bg-[linear-gradient(120deg,#fff_0%,#eceaf4_35%,#ffb7cc_55%,#d1a4ff_75%,#fff_100%)] bg-[length:220%_100%] bg-clip-text text-[clamp(2.6rem,7vw,5rem)] font-extrabold leading-[1.05] tracking-[-0.035em] text-balance text-transparent">
            A timeline for<br />your playlist.
          </h1>
          <div class="rise relative mx-auto mt-7 mb-2 flex h-1.5 w-[min(320px,70%)] items-center gap-0.5" style="--d: 0.06s" aria-hidden="true">
            <span class="h-full flex-[25] animate-breathe rounded-full bg-p1 [--c:var(--color-p1)]"></span>
            <span class="h-full flex-[50] animate-breathe rounded-full bg-p2 [--c:var(--color-p2)] [animation-delay:1.2s]"></span>
            <span class="h-full flex-[35] animate-breathe rounded-full bg-p3 [--c:var(--color-p3)] [animation-delay:2.4s]"></span>
            <span class="h-full flex-[20] animate-breathe rounded-full bg-p4 [--c:var(--color-p4)] [animation-delay:3.6s]"></span>
            <b class="absolute top-3 left-[18%] -translate-x-1/2 animate-twinkle text-xs leading-none font-normal text-muted">☾</b>
            <b class="absolute top-3 left-[90%] -translate-x-1/2 animate-twinkle text-xs leading-none font-normal text-muted [animation-delay:3.6s]">☀</b>
          </div>
          <p class="rise mx-auto mt-6 max-w-[560px] text-[clamp(1.05rem,2vw,1.25rem)] text-pretty text-muted" style="--d: 0.1s">
            Setflow lays a plan over any YouTube Music playlist: colour-coded phases, sunrise and sunset
            markers, and the clock time every track will play.
          </p>
          <div class="rise mt-8 flex flex-wrap items-stretch justify-center gap-3" style="--d: 0.18s">
            <a href={STORE} rel="noopener" class="group relative inline-flex items-center gap-2 overflow-hidden rounded-xl bg-ink px-6 pt-3.5 pb-4 text-[1.05rem] font-semibold text-ground shadow-[0_10px_30px_rgba(0,0,0,0.35)] transition hover:-translate-y-px hover:bg-white">
              <ChromeMark size={18} /> Add to Chrome
              <span class="phase-strip absolute inset-x-0 bottom-0 h-1 transition-[height] group-hover:h-1.5" aria-hidden="true"></span>
            </a>
            <a href={REPO} rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-line bg-sheet px-5 py-3.5 text-[1.05rem] font-semibold transition hover:-translate-y-px hover:bg-sheet-2">
              <GitHubMark size={18} /> View on GitHub
            </a>
          </div>
          <p class="rise mt-4 text-sm text-muted" style="--d: 0.26s">Free and open source. Nothing leaves your browser.</p>
        </div>

        <div class="wrap rise mt-14" style="--d: 0.4s">
          <Demo />
          <p class="mx-auto mt-5 max-w-[640px] text-center text-sm text-muted">
            A live mock of the extension. Edit the plan on the left and the playlist follows. Hover the strip or a track.
            In the real thing the playlist is marked once you press <b class="text-ink">Start planning</b>.
          </p>
        </div>
      </section>

      <section id="features" class="wrap pt-24">
        <h2 class:list={[h2, 'reveal']}>Built for long nights and early mornings.</h2>
        <ul class="mt-10 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f, i) => {
            const Icon = f.icon
            return (
              <li class="reveal bg-ground p-6 transition-colors hover:bg-sheet" style={`--d: ${i * 0.05}s`}>
                <Icon size={22} class={f.tone} />
                <h3 class="mt-4 text-[1.05rem] font-semibold">{f.title}</h3>
                <p class="mt-2 text-[14.5px] text-muted">{f.text}</p>
              </li>
            )
          })}
        </ul>
        <p class="mt-5 flex items-center gap-2 text-sm text-muted">
          <ShieldCheck size={16} class="shrink-0" /> Local only. Journeys, presets and drafts live in the extension's storage. No account, no server, no analytics.
        </p>
      </section>

      <section id="how" class="wrap pt-24">
        <h2 class:list={[h2, 'reveal']}>Three steps, then it stays out of the way.</h2>
        <ol class="mt-10 grid gap-4 md:grid-cols-3">
          {steps.map((s, i) => {
            const Icon = s.icon
            return (
              <li class="reveal rounded-card border border-line p-6" style={`--d: ${i * 0.08}s`}>
                <div class="flex items-center justify-between">
                  <span class="grid size-8 place-items-center rounded-full bg-gradient-to-br from-p2 to-p3 text-sm font-bold text-white">{i + 1}</span>
                  <Icon size={20} class="text-muted" />
                </div>
                <h3 class="mt-4 text-[1.05rem] font-semibold">{s.title}</h3>
                <p class="mt-2 text-[14.5px] text-muted">{s.text}</p>
              </li>
            )
          })}
        </ol>
      </section>

      <section id="releases" class="wrap pt-24">
        <h2 class:list={[h2, 'reveal']}>What's new.</h2>
        {latest && (
          <article class="reveal mt-10 rounded-card border border-transparent bg-[linear-gradient(var(--color-sheet),var(--color-sheet))_padding-box,linear-gradient(135deg,rgba(233,30,99,0.7),rgba(156,39,176,0.7),rgba(66,165,245,0.4))_border-box] p-6">
            <header class="mb-5 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <Tag size={18} class="text-muted" />
                <span class="text-xl font-bold">{latest.tag}</span>
                <span class="text-sm text-muted">{formatDate(latest.date)}</span>
                <span class="rounded-full bg-gradient-to-br from-p2 to-p3 px-2.5 py-0.5 text-[11px] font-bold tracking-wide text-white">Latest</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {latest.zip && (
                  <a class="inline-flex items-center gap-1.5 rounded-lg bg-ink px-3.5 py-2 text-[13px] font-semibold text-ground transition hover:bg-white" href={latest.zip.url}>
                    <Download size={14} /> setflow-extension.zip <span class="opacity-60">{formatSize(latest.zip.size)}</span>
                  </a>
                )}
                <a class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-ground px-3.5 py-2 text-[13px] font-semibold transition hover:bg-sheet-2" href={latest.url} rel="noopener">
                  Release notes <ArrowUpRight size={14} />
                </a>
              </div>
            </header>
            <div class={notesClass}>
              {latest.sections.length === 0 && <p class="text-muted">See the release notes on GitHub.</p>}
              {latest.sections.map((s) => (
                <div>
                  <h4 class="mb-2 text-xs font-bold tracking-wider text-muted uppercase">{s.title}</h4>
                  <ul class="list-disc space-y-1 pl-4 text-[14.5px] marker:text-muted">
                    {s.items.map((item) => <li set:html={inline(item)} />)}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        )}
        <div class="mt-3 grid gap-2.5">
          {older.map((r) => (
            <details class="group reveal rounded-card border border-line bg-sheet">
              <summary class="flex cursor-pointer items-center gap-3 px-5 py-4 [&::-webkit-details-marker]:hidden">
                <span class="font-bold">{r.tag}</span>
                <span class="text-sm text-muted">{formatDate(r.date)}</span>
                <span class="ml-auto text-[13px] text-muted">
                  {r.sections.length ? `${r.sections.reduce((n, s) => n + s.items.length, 0)} changes` : 'see GitHub'}
                </span>
                <ChevronDown size={16} class="text-muted transition-transform group-open:rotate-180" />
              </summary>
              <div class:list={[notesClass, 'px-5 pb-5']}>
                {r.sections.length === 0 && (
                  <p class="text-muted">No notes were written for this one. <a class="text-ink underline" href={r.url} rel="noopener">See it on GitHub.</a></p>
                )}
                {r.sections.map((s) => (
                  <div>
                    <h4 class="mb-2 text-xs font-bold tracking-wider text-muted uppercase">{s.title}</h4>
                    <ul class="list-disc space-y-1 pl-4 text-[14.5px] marker:text-muted">
                      {s.items.map((item) => <li set:html={inline(item)} />)}
                    </ul>
                  </div>
                ))}
                <p class="col-span-full flex items-center gap-3 text-[13px] text-muted">
                  <a class="inline-flex items-center gap-1 hover:text-ink" href={r.url} rel="noopener">Release on GitHub <ArrowUpRight size={13} /></a>
                  {r.zip && <a class="inline-flex items-center gap-1 hover:text-ink" href={r.zip.url}><Download size={13} /> zip</a>}
                </p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <section id="about" class="wrap pt-24">
        <div class="reveal grid items-center gap-8 rounded-card border border-line bg-sheet p-7 sm:grid-cols-[auto_1fr]">
          <img class="size-[120px] rounded-full bg-gradient-to-br from-p2 to-p3 p-1" src="/kasun.png" width="120" height="120" alt="Kasun Vithanage" loading="lazy" />
          <div>
            <h2 class:list={[h2]}>Made by Kasun Vithanage.</h2>
            <p class="mt-2.5 text-[1.05rem]">CTO at WaveZync, based in Sri Lanka. Open source at heart, always learning something new.</p>
            <p class="mt-2 text-muted">
              Setflow is a personal side project, built and maintained in the open. Found a bug or have an idea? <a class="text-ink underline decoration-muted underline-offset-2 hover:decoration-ink" href={`${REPO}/issues`} rel="noopener">Open an issue</a>.
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-ground px-3.5 py-2 text-[13px] font-semibold transition hover:bg-sheet-2" href="https://github.com/kasvith" rel="noopener"><GitHubMark size={14} /> GitHub</a>
              <a class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-ground px-3.5 py-2 text-[13px] font-semibold transition hover:bg-sheet-2" href="https://kasvith.me" rel="noopener"><Globe size={14} /> kasvith.me</a>
              <a class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-ground px-3.5 py-2 text-[13px] font-semibold transition hover:bg-sheet-2" href="https://x.com/kasvith" rel="noopener"><AtSign size={14} /> kasvith</a>
            </div>
          </div>
        </div>
      </section>

      <section id="install" class="wrap grid items-center gap-10 py-24 md:grid-cols-2">
        <div class="reveal">
          <h2 class:list={[h2]}>One click from the Chrome Web Store.</h2>
          <p class="mt-3 text-muted">Updates arrive on their own. Then open a playlist on YouTube Music and click the Setflow icon.</p>
          <a class="mt-6 inline-block rounded-lg transition hover:-translate-y-px" href={STORE} rel="noopener">
            <img class="block rounded-lg" src="/cws-badge.png" width="206" height="58" alt="Available in the Chrome Web Store" />
          </a>
        </div>
        <details class="group reveal rounded-card border border-line bg-sheet">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 font-semibold [&::-webkit-details-marker]:hidden">
            Prefer to load it yourself?
            <ChevronDown size={16} class="text-muted transition-transform group-open:rotate-180" />
          </summary>
          <ol class="grid gap-2 px-3 pb-3">
            <li class="flex items-start gap-3 rounded-xl bg-ground px-4 py-3 text-[15px]"><Download size={18} class="mt-0.5 shrink-0 text-muted" /><span>Download <b>setflow-extension.zip</b> from the <a class="underline decoration-muted underline-offset-2" href={`${REPO}/releases/latest`} rel="noopener">latest release</a> and unzip it.</span></li>
            <li class="flex items-start gap-3 rounded-xl bg-ground px-4 py-3 text-[15px]"><ToggleRight size={18} class="mt-0.5 shrink-0 text-muted" /><span>Open <code class="rounded-md bg-sheet-2 px-1.5 py-px font-mono text-[0.9em]">chrome://extensions</code> and switch on <b>Developer mode</b>, top right.</span></li>
            <li class="flex items-start gap-3 rounded-xl bg-ground px-4 py-3 text-[15px]"><FolderOpen size={18} class="mt-0.5 shrink-0 text-muted" /><span>Click <b>Load unpacked</b> and pick the unzipped folder.</span></li>
            <li class="flex items-start gap-3 rounded-xl bg-ground px-4 py-3 text-[15px]"><RefreshCw size={18} class="mt-0.5 shrink-0 text-muted" /><span>Updates are a new zip over the same folder.</span></li>
          </ol>
        </details>
      </section>
    </main>

    <footer class="border-t border-line py-8 text-sm text-muted">
      <div class="wrap flex flex-wrap items-center justify-between gap-3">
        <span>Setflow · MIT licence · by <a class="hover:text-ink" href="https://kasvith.me" rel="noopener">Kasun Vithanage</a></span>
        <span class="flex flex-wrap items-center gap-4">
          <a class="inline-flex items-center gap-1.5 hover:text-ink" href={STORE} rel="noopener"><ChromeMark size={14} /> Chrome Web Store</a>
          <a class="inline-flex items-center gap-1.5 hover:text-ink" href={REPO} rel="noopener"><GitHubMark size={14} /> GitHub</a>
          <a class="inline-flex items-center gap-1.5 hover:text-ink" href={`${REPO}/issues`} rel="noopener"><MessageSquarePlus size={14} /> Issues</a>
          <a class="inline-flex items-center gap-1.5 hover:text-ink" href="/privacy"><ShieldCheck size={14} /> Privacy</a>
        </span>
      </div>
    </footer>
  </body>
</html>
